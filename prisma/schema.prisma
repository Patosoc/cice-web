
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tip_Inst {
  id_tip_inst Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

model Institucion {
  a_o                      String?
  secretaria               String?
  codigodepartamento       String?
  nombredepartamento       String?
  codigomunicipio          String?
  nombremunicipio          String?
  codigoestablecimiento    String   @id
  nombreestablecimiento    String?
  zona                     String?
  direccion                String?
  telefono                 String?
  codigo_etc               String?
  tipo_establecimiento     String?
  etnias                   String?
  sector                   String?
  genero                   String?
  niveles                  String?
  jornada                  String?
  caracter                 String?
  especialidad             String?
  grados                   String?
  modelos_educativos       String?
  modelos                  String?
  discapacidades           String?
  idiomas                  String?
  numero_de_sedes          String?
  estado                   String?
  prestador_de_servicio    String?
  propiedad_planta_fisica  String?
  resguardo                String?
  matricula_contratada     String?
  calendario               String?
  internado                String?
  estrato_socio_economico  String?
  correo_electronico      String?

  @@index([codigodepartamento], map: "institucion_departamento_idx")
  @@index([codigomunicipio], map: "institucion_municipio_idx")
  @@index([secretaria], map: "institucion_secretaria_idx")
}

model Rol {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  users       User[]
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  email          String
  passwordHash   String
  telefono       String
  roleId         Int
  role           Rol      @relation(fields: [roleId], references: [id])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  mfa            UserMfa?
  passkeys       Passkey[]
  recoveryCodes  RecoveryCode[]
  mfaChallenges  MfaChallenge[]
}

model Contacto {
  id                 String   @id @default(cuid())
  nombre             String
  email              String
  telefono           String
  organizacion       String?
  mensaje            String
  autorizacionDatos  Boolean  @default(false)
  fechaAutorizacion  DateTime?
  versionPolitica    String?
  fechaCreacion      DateTime @default(now())
  estado             String   @default("NUEVO")

  @@index([email])
  @@index([fechaCreacion])
  @@map("contactos")
}


enum MfaChallengePurpose {
  TOTP_LOGIN
  PASSKEY_LOGIN
  PASSKEY_REGISTRATION
  TOTP_ENROLLMENT
  RECOVERY_LOGIN
}

model UserMfa {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @unique @db.Uuid
  totpSecretEncrypted      String?
  pendingTotpSecretEncrypted String?
  totpEnabled              Boolean   @default(false)
  totpEnabledAt            DateTime? @db.Timestamptz(6)
  lastTotpStep             BigInt?
  failedAttempts           Int       @default(0)
  lockedUntil              DateTime? @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Passkey {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  credentialId String    @unique
  publicKey    String
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceType   String?
  backedUp     Boolean   @default(false)
  name         String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt   DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model MfaChallenge {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  challenge String               @unique
  purpose   MfaChallengePurpose
  expiresAt DateTime             @db.Timestamptz(6)
  attempts  Int                  @default(0)
  consumedAt DateTime?           @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}
