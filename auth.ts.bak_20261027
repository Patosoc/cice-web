async authorize(credentials) {
  const user = await prisma.user.findUnique({
    where: { email: credentials.email }
  });

  if (!user) return null;

  const valid = await bcrypt.compare(
    credentials.password,
    user.password_hash
  );

  if (!valid) return null;

  return {
    id: user.id,
    name: user.name,
    email: user.email,
    role: user.role
  };
}